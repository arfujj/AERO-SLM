{
  "name": "aeroslm",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:server",
    "dev:web": "npm run dev --workspace @aeroslm/web",
    "dev:server": "npm run dev --workspace @aeroslm/server",
    "build": "npm run build --workspaces",
    "check": "npm run check --workspaces"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  }
}
